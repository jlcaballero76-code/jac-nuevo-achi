<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <linearGradient id="sunGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFD700" />
      <stop offset="100%" stop-color="#F59E0B" />
    </linearGradient>
    <linearGradient id="greenArc" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#008000" />
      <stop offset="100%" stop-color="#16a34a" />
    </linearGradient>
    <linearGradient id="blueArc" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#003366" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>
    <path id="textArc" d="M 95,210 A 175,175 0 0,1 405,210" fill="none" />
  </defs>

  <!-- Outer circle subtle white background -->
  <circle cx="250" cy="250" r="240" fill="#ffffff" stroke="#e2e8f0" stroke-width="3" />

  <!-- Top Curved Text: BARRIO NUEVO ACHÍ -->
  <text font-family="'Montserrat', 'Roboto', sans-serif" font-weight="800" font-size="28" fill="#003366" letter-spacing="3">
    <textPath href="#textArc" startOffset="50%" text-anchor="middle">
      BARRIO NUEVO ACHÍ
    </textPath>
  </text>

  <!-- Green outer circular ring with upper break -->
  <path d="M 125,240 A 145,145 0 1,1 375,240" fill="none" stroke="url(#greenArc)" stroke-width="20" stroke-linecap="round" />

  <!-- Inner Yellow Sun Swoosh -->
  <path d="M 215,135 Q 310,125 365,225" fill="none" stroke="url(#sunGradient)" stroke-width="12" stroke-linecap="round" />

  <!-- House Roof and Chimney -->
  <path d="M 250,120 L 155,220 L 180,220 L 250,150 L 320,220 L 345,220 Z" fill="#008000" />
  <!-- Chimney -->
  <rect x="295" y="155" width="22" height="42" fill="#008000" rx="3" />

  <!-- 4-Pane Window in Roof Gable -->
  <g transform="translate(225, 190)">
    <rect x="0" y="0" width="22" height="22" rx="3" fill="#008000" />
    <rect x="28" y="0" width="22" height="22" rx="3" fill="#008000" />
    <rect x="0" y="28" width="22" height="22" rx="3" fill="#008000" />
    <rect x="28" y="28" width="22" height="22" rx="3" fill="#008000" />
  </g>

  <!-- Lower blue cradle supporting community -->
  <path d="M 105,265 C 135,375 365,375 395,265 C 370,390 130,390 105,265 Z" fill="url(#blueArc)" />

  <!-- Community People (3 Figures) -->
  <!-- Left Figure (Blue) -->
  <g>
    <!-- Head -->
    <circle cx="185" cy="255" r="18" fill="#0055aa" />
    <!-- Body with raised arms -->
    <path d="M 125,215 C 130,285 170,350 205,355 C 185,320 165,290 155,250 Q 148,225 125,215 Z" fill="#0055aa" />
    <path d="M 185,275 C 160,295 145,280 130,225 C 145,245 165,260 215,285 Z" fill="#0055aa" />
  </g>

  <!-- Right Figure (Yellow/Orange) -->
  <g>
    <!-- Head -->
    <circle cx="315" cy="260" r="18" fill="#f59e0b" />
    <!-- Body with raised arms -->
    <path d="M 375,220 C 370,290 330,355 295,360 C 315,325 335,295 345,255 Q 352,230 375,220 Z" fill="#f59e0b" />
    <path d="M 315,280 C 340,300 355,285 370,230 C 355,250 335,265 285,290 Z" fill="#f59e0b" />
  </g>

  <!-- Center Figure (Green Child) -->
  <g>
    <!-- Head -->
    <circle cx="250" cy="300" r="16" fill="#16a34a" />
    <!-- Raised small arms -->
    <path d="M 215,288 Q 230,310 240,320 L 260,320 Q 270,310 285,288 Q 272,305 258,328 L 258,365 L 242,365 L 242,328 Q 228,305 215,288 Z" fill="#16a34a" />
  </g>

  <!-- Bottom Bold Letters: JAC -->
  <text x="250" y="445" font-family="'Montserrat', 'Arial Black', sans-serif" font-weight="900" font-size="64" fill="#008000" text-anchor="middle" letter-spacing="12">
    JAC
  </text>
</svg>
